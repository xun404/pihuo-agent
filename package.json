{
  "name": "swarmdesk-agent",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Desktop multi-agent command center powered by Mastra and ACP",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @swarmdesk-agent/desktop",
    "desktop": "npm run desktop -w @swarmdesk-agent/desktop",
    "dev:electron": "npm run desktop -w @swarmdesk-agent/desktop",
    "dev:mastra": "npm run dev:api -w @swarmdesk-agent/mastra-app",
    "dev:mastra:studio": "npm run dev -w @swarmdesk-agent/mastra-app",
    "dev:all": "npm run desktop",
    "test": "node --import tsx --test \"packages/**/*.test.ts\" \"apps/**/*.test.ts\" \"apps/**/*.test.tsx\" \"scripts/**/*.test.ts\"",
    "build": "npm run build -w @swarmdesk-agent/shared && npm run build -w @swarmdesk-agent/core && npm run build -w @swarmdesk-agent/adapters && npm run build -w @swarmdesk-agent/mastra-app && npm run build -w @swarmdesk-agent/desktop",
    "build:runtime": "node apps/desktop/scripts/build-api-runtime.mjs",
    "verify:runtime": "node apps/desktop/scripts/verify-api-runtime.mjs",
    "sync:model-registry": "npm run sync:model-registry -w @swarmdesk-agent/mastra-app",
    "package:prepare": "npm run sync:model-registry && npm run sync:acp-registry && npm run build && npm run build:runtime && npm run verify:runtime",
    "package:dir": "npm run package:prepare && electron-builder --dir --publish never",
    "package:mac": "npm run package:prepare && electron-builder --mac --arm64 --publish never",
    "package:win": "npm run package:prepare && electron-builder --win --x64 --publish never",
    "package:linux": "npm run package:prepare && electron-builder --linux --x64 --publish never",
    "smoke:packaged": "node apps/desktop/scripts/run-packaged-smoke.mjs",
    "test:release-contract": "node --import tsx --test scripts/release-contract.test.ts scripts/workflow-contract.test.ts",
    "verify:release-tag": "node scripts/verify-release-tag.mjs",
    "verify:release-assets": "node scripts/verify-release-assets.mjs",
    "verify:workflows": "node scripts/validate-workflows.mjs",
    "sync:acp-registry": "npm run sync:acp-registry -w @swarmdesk-agent/mastra-app --",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "restart": "node scripts/restart-dev.mjs",
    "clean": "rm -rf dist-electron release apps/desktop/dist apps/desktop/dist-electron apps/desktop/dist-runtime packages/shared/dist packages/mastra-app/dist packages/mastra-app/.mastra",
    "test:acp-registry-contract": "node --import tsx --test scripts/acp-registry-contract.test.ts",
    "smoke:acp-registry": "node scripts/acp-registry-smoke.mjs",
    "capture:readme": "node scripts/capture-readme-shots.mjs",
    "capture:readme:en": "node scripts/capture-readme-shots.mjs --locale en",
    "capture:readme:zh": "node scripts/capture-readme-shots.mjs --locale zh"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "author": {
    "name": "xun404",
    "email": "xun404@users.noreply.github.com"
  },
  "homepage": "https://github.com/xun404/swarmdesk-agent#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xun404/swarmdesk-agent.git"
  },
  "bugs": {
    "url": "https://github.com/xun404/swarmdesk-agent/issues"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^43.1.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "prettier": "^3.9.5",
    "typescript-eslint": "^8.64.0",
    "yaml": "2.9.0"
  },
  "overrides": {
    "@electron/get": "5.0.0"
  },
  "optionalDependencies": {
    "@libsql/darwin-arm64": "0.5.29",
    "@libsql/darwin-x64": "0.5.29",
    "@libsql/linux-arm64-gnu": "0.5.29",
    "@libsql/linux-arm64-musl": "0.5.29",
    "@libsql/linux-x64-gnu": "0.5.29",
    "@libsql/linux-x64-musl": "0.5.29",
    "@libsql/win32-x64-msvc": "0.5.29",
    "@rollup/rollup-darwin-arm64": "4.62.2",
    "@rollup/rollup-darwin-x64": "4.62.2",
    "@rollup/rollup-linux-x64-gnu": "4.62.2",
    "@rollup/rollup-linux-x64-musl": "4.62.2",
    "@rollup/rollup-win32-x64-msvc": "4.62.2"
  }
}
