{
  "name": "@pihuo-agent/desktop",
  "version": "0.1.0",
  "description": "PiHuo desktop — you name the job, Pi hands it out",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "author": {
    "name": "xun404",
    "email": "xun404@users.noreply.github.com"
  },
  "license": "MIT",
  "scripts": {
    "predesktop": "node scripts/ensure-electron.mjs",
    "prebuild": "node scripts/ensure-electron.mjs",
    "dev": "vite",
    "dev:electron": "node scripts/ensure-electron.mjs && node scripts/vite-electron.mjs",
    "desktop": "node scripts/ensure-electron.mjs && node scripts/vite-electron.mjs",
    "build": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit && node scripts/vite-electron.mjs build && node scripts/verify-electron-build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\" \"src/**/*.test.tsx\" \"electron/**/*.test.ts\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "@emotion/is-prop-valid": "^1.4.0",
    "@pihuo-agent/shared": "0.1.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "framer-motion": "^14.3.0",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "typescript": "7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-electron": "^1.1.2"
  }
}
