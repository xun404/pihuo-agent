{
  "name": "@swarmdesk-agent/desktop",
  "version": "0.1.0",
  "description": "Desktop multi-agent command center powered by Mastra and ACP",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "author": {
    "name": "xun404",
    "email": "xun404@users.noreply.github.com"
  },
  "license": "MIT",
  "scripts": {
    "predesktop": "node scripts/ensure-electron.mjs",
    "dev": "vite",
    "dev:electron": "ELECTRON=1 vite",
    "desktop": "ELECTRON=1 vite",
    "build": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit && ELECTRON=1 vite build && node scripts/verify-electron-build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\" \"src/**/*.test.tsx\" \"electron/**/*.test.ts\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ai-sdk/react": "3.0.232",
    "@swarmdesk-agent/shared": "0.1.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "ai": "6.0.230",
    "framer-motion": "^12.42.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^43.1.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.7"
  }
}
