{
  "name": "@pihuo-agent/pi-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "dev:api": "tsx watch src/http-server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --import tsx src/http-server.ts",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "sync:model-registry": "node --import tsx scripts/sync-model-registry.ts",
    "sync:acp-registry": "node --import tsx scripts/sync-acp-registry.ts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@pihuo-agent/adapters": "0.1.0",
    "@pihuo-agent/core": "0.1.0",
    "@pihuo-agent/shared": "0.1.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "node-pty": "1.1.0",
    "typebox": "^1.4.2",
    "ws": "8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "7.0.2"
  }
}
