{
  "version": 1,
  "description": "Policy for curating Settings → Models built-in list from models.dev (https://models.dev/api.json). Concrete models are generated into builtin-providers.json by sync:model-registry (runs on package).",
  "providers": [
    {
      "id": "openai",
      "name": "OpenAI",
      "apiKeyEnv": "OPENAI_API_KEY",
      "docsUrl": "https://platform.openai.com/docs/models",
      "apiStyle": "openai",
      "baseURL": "https://api.openai.com/v1",
      "maxModels": 8,
      "includePrefixes": ["gpt-5.", "o4-mini"],
      "excludeSubstrings": [
        "image",
        "realtime",
        "embedding",
        "chat-latest",
        "codex-spark",
        "luna",
        "sol",
        "terra",
        "nano",
        "deep-research"
      ],
      "tagRules": [
        { "match": "codex", "tag": "coding" },
        { "match": "mini", "tag": "fast" },
        { "match": "pro", "tag": "flagship" },
        { "match": "o4", "tag": "reasoning" },
        { "match": "", "tag": "flagship" }
      ],
      "contextWindowDefault": 400000,
      "contextWindowByMatch": [
        { "match": "5.4", "contextWindow": 1050000 },
        { "match": "o4", "contextWindow": 200000 }
      ]
    },
    {
      "id": "anthropic",
      "name": "Anthropic",
      "apiKeyEnv": "ANTHROPIC_API_KEY",
      "docsUrl": "https://docs.anthropic.com/en/docs/about-claude/models",
      "apiStyle": "anthropic",
      "baseURL": "https://api.anthropic.com",
      "maxModels": 7,
      "includePrefixes": ["claude-"],
      "excludeSubstrings": ["-2025", "-2026", "fable"],
      "tagRules": [
        { "match": "haiku", "tag": "fast" },
        { "match": "sonnet", "tag": "coding" },
        { "match": "opus", "tag": "flagship" },
        { "match": "", "tag": "flagship" }
      ],
      "contextWindowDefault": 200000,
      "contextWindowByMatch": [
        { "match": "sonnet", "contextWindow": 1000000 },
        { "match": "opus-4-6", "contextWindow": 1000000 }
      ]
    },
    {
      "id": "google",
      "name": "Google",
      "apiKeyEnv": "GOOGLE_GENERATIVE_AI_API_KEY",
      "apiKeyEnvAliases": ["GOOGLE_API_KEY"],
      "docsUrl": "https://ai.google.dev/gemini-api/docs/models",
      "apiStyle": "google",
      "baseURL": "https://generativelanguage.googleapis.com",
      "maxModels": 6,
      "includePrefixes": ["gemini-"],
      "excludeSubstrings": [
        "image",
        "embedding",
        "tts",
        "customtools",
        "omni",
        "gemma",
        "latest"
      ],
      "tagRules": [
        { "match": "flash-lite", "tag": "cheap" },
        { "match": "flash", "tag": "fast" },
        { "match": "pro", "tag": "flagship" },
        { "match": "", "tag": "flagship" }
      ],
      "contextWindowDefault": 1048576
    },
    {
      "id": "xai",
      "name": "xAI",
      "apiKeyEnv": "XAI_API_KEY",
      "docsUrl": "https://docs.x.ai/docs/models",
      "apiStyle": "openai",
      "baseURL": "https://api.x.ai/v1",
      "maxModels": 5,
      "includePrefixes": ["grok-"],
      "excludeSubstrings": ["imagine", "build", "multi-agent", "video", "image"],
      "tagRules": [
        { "match": "reasoning", "tag": "reasoning" },
        { "match": "non-reasoning", "tag": "fast" },
        { "match": "", "tag": "flagship" }
      ],
      "contextWindowDefault": 256000
    },
    {
      "id": "deepseek",
      "name": "DeepSeek",
      "apiKeyEnv": "DEEPSEEK_API_KEY",
      "docsUrl": "https://api-docs.deepseek.com/",
      "apiStyle": "openai",
      "baseURL": "https://api.deepseek.com",
      "maxModels": 4,
      "includePrefixes": ["deepseek-"],
      "excludeSubstrings": [],
      "tagRules": [
        { "match": "reasoner", "tag": "reasoning" },
        { "match": "flash", "tag": "fast" },
        { "match": "pro", "tag": "flagship" },
        { "match": "chat", "tag": "cheap" },
        { "match": "", "tag": "flagship" }
      ],
      "contextWindowDefault": 128000,
      "contextWindowByMatch": [
        { "match": "chat", "contextWindow": 64000 },
        { "match": "reasoner", "contextWindow": 64000 }
      ]
    },
    {
      "id": "opencode-go",
      "name": "OpenCode Go",
      "apiKeyEnv": "OPENCODE_API_KEY",
      "docsUrl": "https://opencode.ai/docs/zen",
      "apiStyle": "openai",
      "baseURL": "https://opencode.ai/zen/go/v1",
      "maxModels": 10,
      "includePrefixes": [
        "qwen3.",
        "glm-",
        "kimi-",
        "minimax-",
        "mimo-",
        "hy3",
        "deepseek-v4",
        "gpt-5.6-luna",
        "grok-4.5"
      ],
      "excludeSubstrings": ["omni"],
      "tagRules": [
        { "match": "code", "tag": "coding" },
        { "match": "flash", "tag": "fast" },
        { "match": "reasoner", "tag": "reasoning" },
        { "match": "max", "tag": "flagship" },
        { "match": "plus", "tag": "flagship" },
        { "match": "pro", "tag": "flagship" },
        { "match": "", "tag": "flagship" }
      ],
      "contextWindowDefault": 200000,
      "contextWindowByMatch": [
        { "match": "qwen3.", "contextWindow": 1048576 },
        { "match": "glm-5", "contextWindow": 1000000 },
        { "match": "kimi-", "contextWindow": 1000000 },
        { "match": "minimax-", "contextWindow": 1000000 }
      ]
    }
  ],
  "defaultLeaderPreferPrefixes": ["openai/gpt-5.", "openai/gpt-5", "openai/gpt-4o"],
  "recommended": [
    {
      "providerId": "openai",
      "preferContains": ["gpt-5."],
      "excludeContains": ["pro", "mini", "codex", "nano", "luna", "sol", "terra"],
      "reason": "balanced"
    },
    {
      "providerId": "anthropic",
      "preferContains": ["sonnet"],
      "excludeContains": ["haiku"],
      "reason": "coding"
    },
    {
      "providerId": "google",
      "preferContains": ["3.5-flash", "flash"],
      "excludeContains": ["lite", "image", "pro"],
      "reason": "fast"
    },
    {
      "providerId": "xai",
      "preferContains": ["grok-4."],
      "excludeContains": ["reasoning", "non-reasoning", "imagine", "build", "multi"],
      "reason": "flagship"
    },
    {
      "providerId": "deepseek",
      "preferContains": ["v4-flash", "flash"],
      "excludeContains": ["pro"],
      "reason": "cheap"
    }
  ]
}
