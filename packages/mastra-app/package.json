{
  "name": "@router-agents/mastra-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "mastra dev",
    "dev:api": "node --import tsx src/http-server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --import tsx src/http-server.ts",
    "test": "node --import tsx --test ../core/src/**/*.test.ts ../adapters/src/**/*.test.ts"
  },
  "dependencies": {
    "@mastra/acp": "^0.3.0",
    "@mastra/ai-sdk": "latest",
    "@mastra/core": "latest",
    "@mastra/libsql": "latest",
    "@mastra/memory": "latest",
    "@router-agents/adapters": "0.1.0",
    "@router-agents/core": "0.1.0",
    "@router-agents/shared": "0.1.0",
    "ai": "^5.0.0",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "mastra": "latest",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
