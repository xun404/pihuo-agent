{
  "name": "@swarmdesk-agent/mastra-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "mastra dev",
    "dev:api": "tsx watch src/http-server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --import tsx src/http-server.ts",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "sync:model-registry": "node --import tsx scripts/sync-model-registry.ts",
    "sync:acp-registry": "node --import tsx scripts/sync-acp-registry.ts"
  },
  "dependencies": {
    "@mastra/ai-sdk": "1.6.2",
    "@mastra/core": "1.51.0",
    "@mastra/libsql": "1.16.0",
    "@mastra/memory": "1.23.0",
    "@swarmdesk-agent/adapters": "0.1.0",
    "@swarmdesk-agent/core": "0.1.0",
    "@swarmdesk-agent/shared": "0.1.0",
    "ai": "6.0.230",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "node-pty": "1.1.0",
    "ws": "8.21.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "mastra": "1.19.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  },
  "optionalDependencies": {
    "@libsql/darwin-arm64": "0.5.29",
    "@libsql/darwin-x64": "0.5.29",
    "@libsql/linux-arm64-gnu": "0.5.29",
    "@libsql/linux-arm64-musl": "0.5.29",
    "@libsql/linux-x64-gnu": "0.5.29",
    "@libsql/linux-x64-musl": "0.5.29",
    "@libsql/win32-x64-msvc": "0.5.29"
  }
}
